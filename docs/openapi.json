    "/devices/{mac}/alarm/release": {
      "post": {
        "tags": [
          "alerts"
        ],
        "summary": "경보 해제 요청",
        "operationId": "release_alarm_devices__mac__alarm_release_post",
        "parameters": [
          {
            "name": "mac",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 12,
              "maxLength": 17,
              "description": "점검장비 라벨의 MAC 주소. 구분자는 서버가 정규화한다",
              "examples": [

          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "POST /devices가 발급한 식별자",
              "title": "Device Id"
            },
            "description": "POST /devices가 발급한 식별자"
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "조회 시작 (UTC, 포함)",
              "title": "From"
            },
            "description": "조회 시작 (UTC, 포함)"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "조회 끝 (UTC, 미포함)",
              "title": "To"
            },
            "description": "조회 끝 (UTC, 미포함)"
          },
          {
            "name": "interval",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "집계 눈금",
              "examples": [
                "2h"
              ],
              "title": "Interval"
            },
            "description": "집계 눈금"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"

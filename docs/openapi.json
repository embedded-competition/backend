    "/v1/devices/{mac}/alarm/release": {
      "post": {
        "tags": [
          "alerts"
        ],
        "summary": "경보 해제 요청",
        "operationId": "release_alarm_v1_devices__mac__alarm_release_post",
        "parameters": [
          {
            "name": "mac",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 12,
              "maxLength": 17,
              "description": "점검장비 라벨의 MAC 주소. 구분자는 서버가 정규화한다",
              "examples": [
                "AA:BB:CC:DD:EE:FF"
              ],
              "title": "Mac"
            },
            "description": "점검장비 라벨의 MAC 주소. 구분자는 서버가 정규화한다"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlarmReleaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlarmReleaseResponse"
                }
              }
            }
          },
          "403": {
            "description": "해제 거부 (사유 비공개)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "MAC에 해당하는 기기 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlarmReleaseRequest": {
        "properties": {
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Note",
            "description": "현장 확인 메모 (선택)"
          }
        },
        "type": "object",
        "title": "AlarmReleaseRequest"
      },
      "AlarmReleaseResponse": {
        "properties": {
          "released": {
            "type": "boolean",
            "title": "Released"
          }
        },
        "type": "object",
        "required": [
          "released"
        ],
        "title": "AlarmReleaseResponse"
      },
      "BucketLevel": {
        "type": "string",
        "enum": [
          "NORMAL",
          "CAUTION",
          "DANGER"
        ],
        "title": "BucketLevel",
        "description": "차트 한 칸이 어느 정도인가. 앱은 이 값으로 칸을 색칠한다.\n\nstatus(사용자 행동)나 stage(진행 단계)와 다른 축이다. 저 둘은 기기 전체를\n말하지만 이것은 센서 하나의 한 구간만 말한다."
      },
      "ChannelResponse": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value",
            "description": "기준선 대비 상대 편차. 평소와 같으면 0",
            "examples": [
              3.1
            ]
          },
          "slope": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slope",
            "description": "value의 분당 변화량",
            "examples": [
              2.4
            ]
          }
        },
        "type": "object",
        "title": "ChannelResponse"
      },
      "ComponentHealth": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ComponentStatus"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail",
            "description": "비정상일 때 원인 요약",
            "examples": [
              "last frame 22m ago"
            ]
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ComponentHealth"
      },
      "ComponentStatus": {
        "type": "string",
        "enum": [
          "ok",
          "degraded",
          "failed",
          "disabled"
        ],
        "title": "ComponentStatus"
      },
      "Condition": {
        "type": "string",
        "enum": [
          "CO_RISE",
          "H2_RISE",
          "VOC_RISE",
          "PRESSURE_RISE",
          "WATER",
          "SENSOR_FAULT",
          "UNKNOWN"
        ],
        "title": "Condition"
      },
      "DetailBucketResponse": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start",
            "description": "눈금 구간의 시작 시각 (UTC, 끝은 미포함)"
          },
          "level": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BucketLevel"
              },
              {
                "type": "null"
              }
            ],
            "description": "이 칸의 정도(평소·주의·위험). 판정 기준이 아직 없어 지금은 항상 null이다 — 프레임 v2의 편차값이 와야 임계를 말할 수 있다"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value",
            "description": "이 칸의 최고치",
            "examples": [
              3.1
            ]
          },
          "slope": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slope",
            "description": "value의 분당 변화량",
            "examples": [
              2.4
            ]
          }
        },
        "type": "object",
        "required": [
          "start"
        ],
        "title": "DetailBucketResponse"
      },
      "DeviceCurrentResponse": {
        "properties": {
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeviceStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "지금 취해야 하는 행동. 관측이 없거나 예열 중이면 null"
          },
          "stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Stage"
              },
              {
                "type": "null"
              }
            ],
            "description": "화재로 가는 진행 단계. 앱은 이 단계까지 칸을 채운다. 판정할 규칙이 아직 없으면 null — NONE('이상 없음')과 다르다"
          },
          "conditions": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array",
            "title": "Conditions",
            "description": "지금 기기에 일어나고 있는 현상들 — 여러 개가 동시에 성립할 수 있다"
          },
          "at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "At",
            "description": "이 응답이 근거로 삼은 마지막 관측 시각 (UTC)"
          },
          "latched": {
            "type": "boolean",
            "title": "Latched",
            "description": "ALARM latch 유지 여부. 자동 해제 없음",
            "default": false
          },
          "water": {
            "type": "boolean",
            "title": "Water",

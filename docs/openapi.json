  "components": {
    "schemas": {
      "AlarmReleaseRequest": {
        "properties": {
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Note",
            "description": "현장 확인 메모 (선택)"
          }
        },
        "type": "object",
        "title": "AlarmReleaseRequest"
      },
      "AlarmReleaseResponse": {
        "properties": {
          "released": {
            "type": "boolean",
            "title": "Released"
          }
        },
        "type": "object",
        "required": [
          "released"
        ],
        "title": "AlarmReleaseResponse"
      },
      "AlertState": {
        "type": "string",
        "enum": [
          "WARMUP",
          "NORMAL",
          "WATCH",
          "ALARM",
          "FAULT"
        ],
        "title": "AlertState"
      },
      "BucketResponse": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start",
            "description": "눈금 구간의 시작 시각 (UTC, 끝은 미포함)"
          },
          "state": {
            "$ref": "#/components/schemas/AlertState",
            "description": "이 구간에서 가장 심각했던 상태"
          },
          "samples": {
            "type": "integer",
            "title": "Samples",
            "description": "이 구간에 들어온 프레임 수",
            "examples": [
              24
            ]
          },
          "gas": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChannelResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "h2": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChannelResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "co": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChannelResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "pressure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChannelResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "tempC": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tempc",
            "examples": [
              26.1
            ]
          },
          "rh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rh",
            "description": "상대습도 %",
            "examples": [
              43.4
            ]
          }
        },
        "type": "object",
        "required": [
          "start",
          "state",
          "samples"
        ],
        "title": "BucketResponse"
      },
      "ChannelResponse": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value",
            "description": "기준선 대비 상대 편차. 평소와 같으면 0",
            "examples": [
              3.1
            ]
          },
          "slope": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slope",
            "description": "value의 분당 변화량",
            "examples": [
              2.4
            ]
          }
        },
        "type": "object",
        "title": "ChannelResponse"
      },
      "ComponentHealth": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ComponentStatus"

            "schema": {
              "$ref": "#/components/schemas/Sensor",
              "description": "단일 측정 채널"
            },
            "description": "단일 측정 채널"
          },
          {
            "name": "mac",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 12,

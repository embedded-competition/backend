              },
              {
                "type": "null"
              }
            ],
            "title": "Note",
            "description": "현장 확인 메모 (선택)"
          }
        },
        "type": "object",
        "title": "AlarmReleaseRequest"
      },
      "AlarmReleaseResponse": {
        "properties": {
          "released": {
            "type": "boolean",
            "title": "Released"
          }
        },
        "type": "object",
        "required": [
          "released"
        ],
        "title": "AlarmReleaseResponse"
      },
      "AlertState": {
        "type": "string",
        "enum": [
          "WARMUP",
          "NORMAL",
          "WATCH",
          "ALARM",
          "FAULT"
        ],
        "title": "AlertState"
      },
      "BucketResponse": {
        "properties": {
          "gas": {
            "$ref": "#/components/schemas/GasChannelResponse"
          },
          "h2": {
            "$ref": "#/components/schemas/GasChannelResponse"
          },
          "co": {
            "$ref": "#/components/schemas/GasChannelResponse"
          },
          "tempC": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tempc",
            "examples": [
              26.1
            ]
          },
          "rh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rh",
            "examples": [
              43.4
            ]
          },
          "presDev": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Presdev"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start",

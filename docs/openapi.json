        ],
        "summary": "마지막으로 보고된 위치",
        "operationId": "device_location_v1_devices__mac__location_get",
        "parameters": [
          {
            "name": "mac",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 12,
              "maxLength": 17,
              "description": "점검장비 라벨의 MAC 주소. 구분자는 서버가 정규화한다",
              "examples": [
                "AA:BB:CC:DD:EE:FF"
              ],
              "title": "Mac"
            },
            "description": "점검장비 라벨의 MAC 주소. 구분자는 서버가 정규화한다"

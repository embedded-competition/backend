        "type": "object",
        "required": [
          "items"
        ],
        "title": "EventListResponse"
      },
      "EventResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "examples": [
              "evt_1"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "kind": {
            "type": "string",
            "title": "Kind",
            "examples": [
              "state_change",
              "action",
              "suppressed"
            ]
          },
          "description": {
            "type": "string",
            "title": "Description",

# 환경변수 템플릿. 값은 비운다 — 실제 .env는 커밋하지 않는다.
# 모든 키는 app/core/config.py의 Settings가 SSOT다 (extra="forbid" — 오타 나면 부팅 실패).

APP_ENVIRONMENT=local            # local | pi
APP_ENABLE_DOCS=true             # Pi에서 인터넷 노출 시 false 권장

# --- 데이터베이스 ---
APP_DATABASE_PATH=data/orca.db

# --- LoRa (SX1276 SPI) ---
# 노드 펌웨어와 값이 하나라도 어긋나면 수신 0이 된다.
# 기준값은 docs/lora-frame.md와 함께 관리한다.
APP_LORA_SOURCE=fake             # sx1276 | fake (하드웨어 없는 개발 환경)
APP_LORA_SPI_BUS=0
APP_LORA_SPI_DEVICE=0
APP_LORA_DIO0_GPIO=25
APP_LORA_RESET_GPIO=22
APP_LORA_FREQUENCY_HZ=922000000  # 한국 ISM 917.0~923.5MHz, duty cycle 제약 준수
APP_LORA_SPREADING_FACTOR=7
APP_LORA_BANDWIDTH_HZ=125000
APP_LORA_CODING_RATE=5
APP_LORA_PREAMBLE_LENGTH=8
APP_LORA_SYNC_WORD=18

# --- 노드 생존 판정 ---
APP_HEARTBEAT_INTERVAL_S=300     # 펌웨어 확정 시 조정
APP_OFFLINE_AFTER_MISSED_BEATS=3

# --- 푸시 (FCM) ---
# 비밀값에 기본값을 주지 않는다. 키 파일은 커밋하지 않고 권한 600으로 둔다.
APP_FCM_CREDENTIALS_PATH=
APP_FCM_PROJECT_ID=
APP_PUSH_TIMEOUT_S=10
APP_PUSH_MAX_ATTEMPTS=3

# --- CORS ---
# 앱 origin만 명시. "*" + credentials 조합 금지.
APP_CORS_ALLOW_ORIGINS=

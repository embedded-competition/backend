# 환경변수 템플릿. 값은 비운다 — 실제 .env는 커밋하지 않는다.
# 모든 키는 app/core/config.py의 Settings가 SSOT다 (extra="forbid" — 오타 나면 부팅 실패).
#
# 값 뒤에 주석을 붙이지 않는다. systemd EnvironmentFile은 줄 끝 #을 값의 일부로 읽는다
# (python-dotenv와 다르다). 주석은 항상 자기 줄에 둔다.

# local | pi
APP_ENVIRONMENT=local
# Pi에서 인터넷 노출 시 false
APP_ENABLE_DOCS=true

# --- 로깅 ---
# app.* 로거만 이 레벨로 연다. 서드파티(sqlalchemy 등)는 WARNING 고정 —
# root까지 열면 쿼리 로그가 SD카드를 채운다.
# DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO
# json = extra= 로 실은 필드가 키로 남는다(journald·수집기 파싱용). Pi 권장.
# text = 사람이 읽는 한 줄. 로컬 개발 기본값.
APP_LOG_FORMAT=text

# --- 데이터베이스 ---
APP_DATABASE_PATH=data/orca.db

# --- LoRa (SX1276 SPI) ---
# 노드 펌웨어와 값이 하나라도 어긋나면 수신 0이 된다.
# 기준값은 docs/lora-frame.md와 함께 관리한다.
# 수신 task 자체 on/off
APP_LORA_ENABLED=true
# sx1276 = SPI 직결 모듈 | rylr = UART AT 모듈 | fake = 하드웨어 없는 개발 환경
APP_LORA_SOURCE=fake
# fake source가 흉내낼 노드 MAC
APP_FAKE_NODE_HW_ID=aabbccddeeff
APP_FAKE_INTERVAL_S=3.0
APP_LORA_SPI_BUS=0
APP_LORA_SPI_DEVICE=0
# 초기화 전에 거는 하드웨어 리셋. 값이 배선과 다르면 칩이 이상 상태로 남는다.
APP_LORA_RESET_GPIO=22
# 한국 ISM 917.0~923.5MHz, duty cycle 제약 준수
APP_LORA_FREQUENCY_HZ=922000000
APP_LORA_SPREADING_FACTOR=7
APP_LORA_BANDWIDTH_HZ=125000
APP_LORA_CODING_RATE=5
APP_LORA_PREAMBLE_LENGTH=8
APP_LORA_SYNC_WORD=18

# --- RYLR (UART AT 모듈, APP_LORA_SOURCE=rylr 일 때만) ---
# GPIO 8·10번 직결이면 /dev/serial0, FTDI 경유 USB면 /dev/ttyUSB0.
# 주파수·SF·대역폭·코딩레이트·프리앰블은 위 LoRa 항목을 그대로 쓴다.
APP_RYLR_PORT=/dev/serial0
APP_RYLR_BAUD=115200
# 이 수신기의 주소. 노드의 AT+SEND 대상과 같아야 한다.
APP_RYLR_ADDRESS=1
# 같은 값끼리만 통신한다. 3~15 또는 18.
APP_RYLR_NETWORK_ID=18
# hex = 노드가 바이너리 프레임을 hex 문자열로 보냄 (기본).
# text = 받은 문자를 그대로 바이트로 쓴다. 프레임에 콤마가 있으면 hex를 써라.
APP_RYLR_PAYLOAD=hex

# --- 노드 생존 판정 ---
# 펌웨어 확정 시 조정
APP_HEARTBEAT_INTERVAL_S=300
APP_OFFLINE_AFTER_MISSED_BEATS=3

# --- 푸시 (Expo) ---
# log = 발송 대신 로그만 — 실기기 없이 알람 흐름을 검증한다. 실제 발송은 expo.
APP_PUSH_DELIVERY=log
APP_PUSH_TIMEOUT_S=10
APP_PUSH_MAX_ATTEMPTS=3

# --- 운영 정보 ---
# 등록 시 앱에 내려주는 관리실 번호. 앱에 하드코딩하지 않는다.
APP_MANAGEMENT_PHONE=

# --- CORS ---
# 앱 origin만 명시. "*" + credentials 조합 금지.
# tuple 필드라 JSON 배열로 적는다. 빈 값(=)은 JSON이 아니라 부팅이 깨진다.
APP_CORS_ALLOW_ORIGINS=[]
